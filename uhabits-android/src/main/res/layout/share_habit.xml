<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?windowBackgroundColor">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/Toolbar"
        app:popupTheme="?toolbarPopupTheme" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbar">

        <LinearLayout
            android:id="@+id/outerLinearLayout"
            style="@style/CardList">

            <!-- Not shared yet -->
            <LinearLayout
                android:id="@+id/notSharedCard"
                style="@style/Card">

                <TextView
                    style="@style/About.Item"
                    android:text="@string/share_intro" />

                <RadioGroup
                    android:id="@+id/historyGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/historyToday"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/share_history_today" />

                    <RadioButton
                        android:id="@+id/historyAll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/share_history_all" />
                </RadioGroup>

                <TextView
                    style="@style/About.Item"
                    android:text="@string/share_notes_private" />

                <TextView
                    android:id="@+id/newShareServer"
                    style="@style/About.Item"
                    android:textColor="?contrast60" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shareButton"
                    style="@style/ShareTextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/share_start" />
            </LinearLayout>

            <!-- Shared -->
            <LinearLayout
                android:id="@+id/sharedCard"
                style="@style/Card"
                android:visibility="gone">

                <TextView
                    style="@style/About.Item"
                    android:text="@string/shared_with_friends"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/shareServer"
                    style="@style/About.Item"
                    android:textColor="?contrast60" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/inviteButton"
                    style="@style/ShareTextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/share_invite" />

                <LinearLayout
                    android:id="@+id/invitePanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/inviteQr"
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_gravity="center"
                        android:layout_margin="8dp"
                        android:background="@android:color/white"
                        android:contentDescription="@string/share_invite_qr"
                        android:padding="8dp" />

                    <TextView
                        android:id="@+id/inviteLink"
                        style="@style/About.Item"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/inviteHint"
                        style="@style/About.Item"
                        android:textColor="?contrast60" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sendLinkButton"
                        style="@style/ShareTextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="@string/share_send_link" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/friendsCard"
                style="@style/Card"
                android:visibility="gone">

                <TextView
                    style="@style/About.Item"
                    android:text="@string/share_friends"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/friendsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stopButton"
                    style="@style/ShareTextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="@string/share_stop" />
            </LinearLayout>

            <TextView
                android:id="@+id/status"
                style="@style/About.Item"
                android:layout_margin="12dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="12dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
